# Dependencies
node_modules/

# Build output — Vite (client) and tsc (server)
dist/

# Environment and secrets — never commit these
.env
.env.local
.env.*.local
*.pem

# Test and tooling output
coverage/
*.tsbuildinfo
.eslintcache

# Playwright e2e output
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Per-machine Claude Code permissions — not shared repo config
.claude/settings.local.json

# Конфиг запуска дев-сервера для Claude Code — на каждой машине свой (порт
# может быть занят, путь до pnpm свой). В репозитории лежит только образец
# .claude/launch-example.json — скопировать его в .claude/launch.json и
# поправить под себя.
.claude/launch.json

# Local git worktrees — scratch checkouts, not repo content
.claude/worktrees/

# Subagent-driven-development scratch workspace — ledgers, briefs, review packages
.superpowers/

# Local game state — SQLite (planned, see docs/ideas.md "Память и обучение генератора")
*.db
*.db-journal

# Room state snapshot written by server/src/index.ts at runtime, plus the
# temp file writeSnapshot() writes-then-renames for atomicity
room-snapshot.json
room-snapshot.json.tmp
e2e/fixtures/final-room-snapshot.json
e2e/fixtures/final-room-snapshot.json.tmp

# Saved LAN address override (server/src/lan-host.ts) — this machine's own
# network-adapter pick, not something to share across machines/checkouts.
lan-host.local.json
lan-host.local.json.tmp
